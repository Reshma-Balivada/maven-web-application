pipeline {
  agent any
  stages {
    stage('Checkout') {
      steps {
        git branch: 'master', url: 'https://github.com/Reshma-Balivada/maven-web-application.git'
      }
    }
    stage('Build') {
      steps {
        sh 'mvn clean package'
      }
    }
  }
  post {
    always { echo "Done" }
  }
}
post {
    always {
        withCredentials([string(credentialsId: 'slack-webhook', variable: 'SLACK_URL')]) {
            sh """
            curl -X POST -H 'Content-type: application/json' \
            --data '{"text":"Build ${currentBuild.currentResult}: ${env.JOB_NAME} #${env.BUILD_NUMBER}"}' \
            "$SLACK_URL"
            """
        }
    }
}
